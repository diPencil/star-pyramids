# STAR PYRAMIDS — environment template (safe to commit).
# Copy to `.env` for local development and fill real values.
# NEVER commit real credentials. `.env*` (except this file) is gitignored.

# MySQL connection (Prisma). Format only — placeholders, no real values.
# Local XAMPP example: mysql://root:@127.0.0.1:3306/star_pyramids
DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE"

# First Super Admin bootstrap (used by `pnpm db:bootstrap`, never seeded).
BOOTSTRAP_ADMIN_EMAIL=""
# Optional: if empty, the bootstrap script prompts securely instead.
BOOTSTRAP_ADMIN_PASSWORD=""

# ─── Server-side media storage (uploaded images) ──────────────────────────
# Uploaded images are written as real files and served from /media/<key>.
# This directory MUST be persistent and writable: it survives restarts and
# redeploys, and must be backed up together with the database (the database
# holds the references, this directory holds the bytes).
# Defaults to <project>/storage/media when unset.
# MEDIA_STORAGE_DIR="/var/lib/star-pyramids/media"
# Optional: per-file size ceiling in bytes. Default 5242880 (5 MB).
# The admin UI additionally caps catalogue images at 1.5 MB and avatars
# at 2 MB.
# MEDIA_MAX_UPLOAD_BYTES="5242880"

# ─── Guest booking access (private booking links) ──────────────────────────
# Guests who book without an account open their booking through a private
# expiring link. This is the lifetime of that link in days.
# Default 90. Must be a positive whole number.
# BOOKING_ACCESS_TOKEN_TTL_DAYS="90"

# ─── Transactional email (SMTP) ───────────────────────────────────────────
# The app sends real email over SMTP. Until SMTP_HOST is set, every delivery
# is recorded as FAILED (never SENT) and /admin/emails shows the reason.
# No credential is ever exposed to the browser.

# Required: the SMTP server hostname. e.g. smtp.gmail.com
SMTP_HOST=""
# Optional: server port. Default 587 (STARTTLS). Use 465 with SMTP_SECURE=true.
SMTP_PORT=""
# Optional: "true" for implicit TLS (typical for port 465).
# Leave unset for STARTTLS on 587, which is the recommended default.
SMTP_SECURE=""
# Required for authenticated relay: the mailbox username.
SMTP_USER=""
# Required for authenticated relay: the mailbox password or app password.
SMTP_PASSWORD=""
# Optional: envelope sender address. Defaults to SMTP_USER when omitted.
SMTP_FROM_EMAIL=""
# Optional: sender display name. Defaults to "Star Pyramids Tours".
SMTP_FROM_NAME=""
# Optional: Reply-To address shown to recipients.
SMTP_REPLY_TO=""
# Optional: set to "true" only for an open relay that needs no credentials.
SMTP_ALLOW_UNAUTH=""
# Optional: connection/greeting/socket timeout in ms (1000-120000). Default 15000.
SMTP_TIMEOUT_MS=""

# Example (Gmail app password — never commit a real one):
#   SMTP_HOST="smtp.gmail.com"
#   SMTP_PORT="587"
#   SMTP_USER="sales@yourdomain.com"
#   SMTP_PASSWORD="your-app-password"
#   SMTP_FROM_EMAIL="sales@yourdomain.com"

# 32-byte hexadecimal AES key. Required before saving review provider credentials.
# Generate securely per environment; retain it when deploying and back it up separately.
REVIEW_INTEGRATIONS_KEY=
