// STAR PYRAMIDS — backend schema.
//
// SCOPE: auth foundation (users, roles, sessions, setup tokens) +
// server-authoritative settings (site settings, FX rates) + staff audit +
// Phase 2B customer trip-request workflow (trip_requests + activity +
// submission rate-limit attempts) + Phase 2C customer car-request workflow
// (car_requests + activity + submission rate-limit attempts) + Phase 2D
// customer event-request workflow (event_requests + activity +
// submission rate-limit attempts) + Phase 2E customer booking workflow
// (bookings + items + activity + submission rate-limit attempts) + Phase 2F-A
// payment core (payments + immutable payment events + initiation
// rate-limit attempts) + Phase 2G customer favorites (favorite_items)
// + Phase 2H customer in-app notifications (notifications)
// + Phase 2I customer↔staff support chat (support_conversations +
// support_messages).
// Provider gateway adapters, quotations and all
// other domains belong to later phases and MUST NOT be added here.
//
// Conventions:
// - MySQL is authoritative. UTC datetimes (app writes Date = UTC epoch).
// - Money/FX use DECIMAL, never FLOAT. No formatted currency strings.
// - Passwords only as hashes (see lib/server/password.ts). No demo seeds.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum SetupTokenType {
  PASSWORD_SETUP
}

model Role {
  id          String   @id @default(cuid())
  key         String   @unique @db.VarChar(64)
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignments UserRole[]

  @@map("roles")
}

model User {
  id              String     @id @default(cuid())
  publicId        String     @unique @default(uuid()) @db.VarChar(64)
  email           String     @unique @db.VarChar(190)
  emailNormalized String     @unique @db.VarChar(190)
  firstName       String?    @db.VarChar(80)
  lastName        String?    @db.VarChar(80)
  username        String?    @unique @db.VarChar(64)
  countryCode     String?    @db.Char(2)
  phone           String?    @db.VarChar(32)
  passwordHash    String?    @db.VarChar(255)
  status          UserStatus @default(PENDING)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  roles        UserRole[]
  sessions     Session[]
  setupTokens  AccountSetupToken[]
  auditActions StaffActionAudit[] @relation("AuditActor")
  tripRequests TripRequest[]
  carRequests  CarRequest[]
  eventRequests EventRequest[]
  bookings     Booking[]
  favorites    FavoriteItem[]
  notifications Notification[]
  supportConversations SupportConversation[] @relation("SupportCustomer")
  assignedSupportConversations SupportConversation[] @relation("SupportAssignee")
  supportMessages SupportMessage[]

  @@index([status])
  @@map("users")
}

model UserRole {
  id         String   @id @default(cuid())
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  assignedBy String?  @db.VarChar(64)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique @db.VarChar(128)
  userId     String
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  ipAddress  String?  @db.VarChar(64)
  userAgent  String?  @db.VarChar(255)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model AccountSetupToken {
  id        String         @id @default(cuid())
  tokenHash String         @unique @db.VarChar(128)
  userId    String
  type      SetupTokenType @default(PASSWORD_SETUP)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("account_setup_tokens")
}

model SiteSetting {
  key         String   @id @db.VarChar(100)
  value       String   @db.Text
  description String?  @db.VarChar(255)
  updatedAt   DateTime @updatedAt

  @@map("site_settings")
}

model FxRate {
  id            String   @id @default(cuid())
  baseCurrency  String   @db.Char(3)
  quoteCurrency String   @db.Char(3)
  rate          Decimal  @db.Decimal(18, 8)
  isActive      Boolean  @default(true)
  source        String   @default("manual") @db.VarChar(64)
  effectiveAt   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([baseCurrency, quoteCurrency])
  @@index([quoteCurrency, isActive])
  @@map("fx_rates")
}

model StaffActionAudit {
  id         Int      @id @default(autoincrement())
  actorId    String?
  action     String   @db.VarChar(100)
  entityType String?  @db.VarChar(100)
  entityId   String?  @db.VarChar(64)
  metadata   String?  @db.Text
  createdAt  DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@map("staff_action_audit")
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String   @db.VarChar(190)
  ipAddress String   @db.VarChar(64)
  success   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
  @@map("login_attempts")
}

model RegistrationAttempt {
  id        String   @id @default(cuid())
  email     String   @db.VarChar(190)
  ipAddress String   @db.VarChar(64)
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
  @@map("registration_attempts")
}

enum TripRequestStatus {
  NEW
  REVIEWING
  PROPOSAL_READY
  APPROVED
  REJECTED
  CANCELLED
}

enum TripRequestTimeMode {
  EXACT
  APPROX
  UNSURE
}

/// Phase 2B: customer trip request (Make Your Trip / account planner).
/// The contact block is a historical snapshot taken at submit/edit time and
/// is never rewritten by later profile changes. `userId` links the request
/// to a registered CUSTOMER only when the submission happened under that
/// customer's server session; guest submissions keep `userId` NULL and are
/// identified solely by their contact snapshot. Staff-only discussion lives
/// in internal TripRequestActivity rows and in NO customer-facing field.
model TripRequest {
  id              String            @id @default(cuid())
  reference       String            @unique @db.VarChar(16)
  userId          String?
  contactName     String            @db.VarChar(80)
  contactEmail    String            @db.VarChar(190)
  contactPhone    String            @db.VarChar(32)
  contactDialCode String            @db.VarChar(8)
  nationality     String            @db.Char(2)
  destinationSlug String?           @db.VarChar(80)
  tourSlug        String?           @db.VarChar(80)
  customTitle     String?           @db.VarChar(120)
  requestedAddOns String            @default("[]") @db.Text
  timeMode        TripRequestTimeMode @default(EXACT)
  preferredFrom   DateTime?         @db.Date
  preferredTo     DateTime?         @db.Date
  adults          Int               @default(1)
  children        Int               @default(0)
  infants         Int               @default(0)
  budgetMin       Int               @default(0)
  budgetMax       Int               @default(0)
  budgetCurrency  String            @default("USD") @db.Char(3)
  flightOffer     Boolean           @default(false)
  notes           String?           @db.Text
  status          TripRequestStatus @default(NEW)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user       User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  activities TripRequestActivity[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([contactEmail])
  @@map("trip_requests")
}

model TripRequestActivity {
  id         String   @id @default(cuid())
  requestId  String
  actorRole  String   @db.VarChar(16)
  action     String   @db.VarChar(160)
  note       String?  @db.Text
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())

  request TripRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
  @@map("trip_request_activities")
}

/// Abuse-protection attempts for the public trip-request endpoint.
/// Same architecture as login/registration attempts: counted per
/// email-OR-ip inside a time window, pruned opportunistically.
model TripRequestAttempt {
  id        String   @id @default(cuid())
  email     String   @db.VarChar(190)
  ipAddress String   @db.VarChar(64)
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
  @@map("trip_request_attempts")
}

enum CarRequestStatus {
  NEW
  REVIEWING
  CONFIRMED
  CANCELLED
}

enum CarTripType {
  ONE_WAY
  ROUND_TRIP
}

/// Phase 2C: customer car request (Rent Car / account / admin workflow).
/// Mirrors the Phase 2B trip-request architecture: the contact block is a
/// historical snapshot taken at submit/edit time and is never rewritten by
/// later profile changes. `userId` links the request to a registered
/// CUSTOMER only when the submission happened under that customer's server
/// session; guest submissions keep `userId` NULL and are identified solely
/// by their contact snapshot. `vehicleSlug` is the requested preference;
/// `assignedVehicleSlug` is the staff-assigned fleet vehicle (nullable).
/// Staff-only discussion lives in internal CarRequestActivity rows and in
/// NO customer-facing field.
model CarRequest {
  id                  String          @id @default(cuid())
  reference           String          @unique @db.VarChar(16)
  userId              String?
  vehicleSlug         String          @db.VarChar(80)
  assignedVehicleSlug String?         @db.VarChar(80)
  tripType            CarTripType     @default(ONE_WAY)
  pickup              String          @db.VarChar(160)
  dropoff             String          @db.VarChar(160)
  pickupDate          DateTime?       @db.Date
  returnDate          DateTime?       @db.Date
  passengers          Int             @default(1)
  contactName         String          @db.VarChar(80)
  contactEmail        String          @db.VarChar(190)
  contactPhone        String          @db.VarChar(32)
  notes               String?         @db.Text
  status              CarRequestStatus @default(NEW)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  user       User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  activities CarRequestActivity[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([contactEmail])
  @@map("car_requests")
}

model CarRequestActivity {
  id         String   @id @default(cuid())
  requestId  String
  actorRole  String   @db.VarChar(16)
  action     String   @db.VarChar(160)
  note       String?  @db.Text
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())

  request CarRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
  @@map("car_request_activities")
}

/// Abuse-protection attempts for the public car-request endpoint.
/// Same architecture as trip-request attempts: counted per
/// email-OR-ip inside a time window, pruned opportunistically.
model CarRequestAttempt {
  id        String   @id @default(cuid())
  email     String   @db.VarChar(190)
  ipAddress String   @db.VarChar(64)
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
  @@map("car_request_attempts")
}

enum EventRequestStatus {
  NEW
  REVIEWING
  APPROVED
  REJECTED
  CANCELLED
}

/// Phase 2D: customer event request (Events / account / admin workflow).
/// Mirrors the trip/car-request architecture: the contact block is a
/// historical snapshot taken at submit time and is never rewritten by
/// later profile changes. `userId` links the request to a registered
/// CUSTOMER only when the submission happened under that customer's server
/// session; guest submissions keep `userId` NULL and are identified solely
/// by their contact snapshot. `eventSlug` is the requested event; the
/// title/date/location columns are the snapshot taken at submit time.
/// Customer requests are never edited after submission — customers may only
/// cancel while new/reviewing. Staff-only discussion lives in internal
/// EventRequestActivity rows and in NO customer-facing field.
model EventRequest {
  id            String            @id @default(cuid())
  reference     String            @unique @db.VarChar(16)
  userId        String?
  eventSlug     String            @db.VarChar(80)
  eventTitle    String            @db.VarChar(160)
  eventDate     String            @db.VarChar(120)
  eventLocation String            @db.VarChar(160)
  attendees     Int               @default(1)
  contactName   String            @db.VarChar(80)
  contactEmail  String            @db.VarChar(190)
  contactPhone  String            @db.VarChar(32)
  contactDialCode String          @db.VarChar(8)
  nationality   String            @db.Char(2)
  notes         String?           @db.Text
  status        EventRequestStatus @default(NEW)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  user       User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  activities EventRequestActivity[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([contactEmail])
  @@index([eventSlug])
  @@map("event_requests")
}

model EventRequestActivity {
  id         String   @id @default(cuid())
  requestId  String
  actorRole  String   @db.VarChar(16)
  action     String   @db.VarChar(160)
  note       String?  @db.Text
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())

  request EventRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
  @@map("event_request_activities")
}

/// Abuse-protection attempts for the public event-request endpoint.
/// Same architecture as trip/car-request attempts: counted per
/// email-OR-ip inside a time window, pruned opportunistically.
model EventRequestAttempt {
  id        String   @id @default(cuid())
  email     String   @db.VarChar(190)
  ipAddress String   @db.VarChar(64)
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
  @@map("event_request_attempts")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

/// Honest payment state only. Phase 2E never marks a booking paid:
/// every booking is created PENDING (unpaid) and stays there until the
/// Phase 2F payment gateway exists. PAID/REFUNDED are reserved values.
enum BookingPaymentStatus {
  PENDING
  PAID
  REFUNDED
}

/// Phase 2E: customer booking (cart checkout workflow).
/// Mirrors the request architectures: the contact block is a historical
/// snapshot taken at checkout and never rewritten by later profile
/// changes. `userId` links the booking to a registered CUSTOMER only
/// when checkout happened under that customer server session; guest
/// checkouts keep `userId` NULL. Commercial totals are server-computed
/// from the canonical catalogue in integer cents and stored as DECIMAL;
/// the browser is never trusted for prices, totals, status, payment
/// state, references, or ownership. Currency is always `USD` (base);
/// EUR/EGP switching stays presentation-only. `idempotencyKey` is a
/// client-generated submission key that makes double clicks, retries,
/// and re-renders resolve to ONE booking.
model Booking {
  id             String              @id @default(cuid())
  reference      String              @unique @db.VarChar(16)
  userId         String?
  contactName    String              @db.VarChar(80)
  contactEmail   String              @db.VarChar(190)
  contactPhone   String              @db.VarChar(32)
  notes          String?             @db.Text
  currency       String              @default("USD") @db.Char(3)
  subtotal       Decimal             @db.Decimal(10, 2)
  discount       Decimal             @default(0) @db.Decimal(10, 2)
  total          Decimal             @db.Decimal(10, 2)
  status         BookingStatus       @default(PENDING)
  paymentStatus  BookingPaymentStatus @default(PENDING)
  idempotencyKey String?             @unique @db.VarChar(64)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  user       User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  items      BookingItem[]
  activities BookingActivity[]
  payments   Payment[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([contactEmail])
  @@map("bookings")
}

/// Booking-time commercial snapshot per cart line. `tourSlug` is the
/// canonical catalogue identifier; title/image/date/counts/prices are
/// frozen at checkout so history stays readable if catalogue copy or
/// prices change later. `addons` holds priced add-on titles only;
/// on-request services are preserved on the customer note, never
/// charged. Money columns are server-computed DECIMAL, never browser
/// input.
model BookingItem {
  id         String  @id @default(cuid())
  bookingId  String
  tourSlug   String  @db.VarChar(120)
  tourTitle  String  @db.VarChar(200)
  tourImage  String? @db.VarChar(255)
  travelDate String  @default("") @db.VarChar(10)
  adults     Int     @default(1)
  children   Int     @default(0)
  infants    Int     @default(0)
  addons     Json    @default("[]")
  adultUnit  Decimal @db.Decimal(10, 2)
  childUnit  Decimal @db.Decimal(10, 2)
  infantUnit Decimal @db.Decimal(10, 2)
  addonTotal Decimal @db.Decimal(10, 2)
  lineTotal  Decimal @db.Decimal(10, 2)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("booking_items")
}

model BookingActivity {
  id        String   @id @default(cuid())
  bookingId String
  actorRole String   @db.VarChar(16)
  action    String   @db.VarChar(160)
  note      String?  @db.Text
  isInternal Boolean @default(false)
  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@map("booking_activities")
}

/// Abuse-protection attempts for the public checkout endpoint.
/// Same architecture as request attempts: counted per email-OR-ip
/// inside a time window, pruned opportunistically.
model BookingAttempt {
  id        String   @id @default(cuid())
  email     String   @db.VarChar(190)
  ipAddress String   @db.VarChar(64)
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
  @@map("booking_attempts")
}

/// Phase 2F-A payment lifecycle. A Payment is the money record for one
/// booking; the booking lifecycle (PENDING/CONFIRMED/...) and the
/// payment lifecycle evolve independently — a confirmed booking is NOT
/// automatically paid. `provider` is the gateway key that settled (or
/// will settle) the payment; `pending` means created locally and
/// awaiting provider handoff in Phase 2F-B. No card numbers, CVV, raw
/// card details, or gateway credentials are ever stored here —
/// `metadata` holds non-sensitive provider payload only.
enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

/// Phase 2F-A: provider-agnostic payment record for one booking.
/// `amount` is the server-authoritative amount due, frozen from the
/// booking total at initiation (integer cents in, DECIMAL stored).
/// `amountPaid`/`amountRefunded` accumulate settled money only — they
/// are written by server-side transitions (future provider webhooks
/// or audited offline workflows), never by browser input.
model Payment {
  id                String        @id @default(cuid())
  reference         String        @unique @db.VarChar(16)
  bookingId         String
  provider          String        @default("pending") @db.VarChar(64)
  providerPaymentId String?       @unique @db.VarChar(128)
  status            PaymentStatus @default(PENDING)
  currency          String        @default("USD") @db.Char(3)
  amount            Decimal       @db.Decimal(10, 2)
  amountPaid        Decimal       @default(0) @db.Decimal(10, 2)
  amountRefunded    Decimal       @default(0) @db.Decimal(10, 2)
  failureCode       String?       @db.VarChar(64)
  failureMessage    String?       @db.VarChar(255)
  idempotencyKey    String?       @unique @db.VarChar(64)
  initiatedAt       DateTime      @default(now())
  paidAt            DateTime?
  failedAt          DateTime?
  cancelledAt       DateTime?
  refundedAt        DateTime?
  metadata          String?       @db.Text
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  booking Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  events  PaymentEvent[]

  @@index([bookingId, createdAt])
  @@index([status, createdAt])
  @@map("payments")
}

/// Immutable payment history. Every server-side payment transition
/// appends one row; rows are never updated or deleted except by
/// booking cascade. Customer-facing views exclude internal rows.
model PaymentEvent {
  id        String   @id @default(cuid())
  paymentId String
  actorRole String   @db.VarChar(16)
  action    String   @db.VarChar(160)
  note      String?  @db.Text
  isInternal Boolean @default(false)
  createdAt DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, createdAt])
  @@map("payment_events")
}

/// Abuse-protection attempts for the payment-initiation endpoint.
/// Same architecture as booking attempts: counted per email-OR-ip
/// inside a time window, pruned opportunistically.
model PaymentAttempt {
  id        String   @id @default(cuid())
  email     String   @db.VarChar(190)
  ipAddress String   @db.VarChar(64)
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
  @@map("payment_attempts")
}

/// Phase 2G: customer saved trips (favorites). One row per saved
/// catalogue item per customer — never a copy of the tour itself.
/// Only the stable catalogue key is stored (`itemType` + `itemSlug`);
/// titles, images, and prices always resolve live from the catalogue,
/// so saved rows stay readable if catalogue copy changes. The
/// `@@unique` constraint makes double-saving impossible.
model FavoriteItem {
  id        String   @id @default(cuid())
  userId    String
  itemType  String   @default("tour") @db.VarChar(32)
  itemSlug  String   @db.VarChar(120)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemType, itemSlug])
  @@index([userId, createdAt])
  @@map("favorite_items")
}

/// Phase 2H: customer in-app notifications. One row per customer-facing
/// domain event, owned by exactly one user — never shared, never
/// client-created. Only display data is stored (type + title + message
/// + optional relative target path); no sensitive payloads, no payment
/// secrets, no internal staff notes. `readAt` (nullable) is the read
/// marker: NULL means unread. New events from this phase onward only —
/// historical records are never backfilled.
model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   @db.VarChar(48)
  title     String   @db.VarChar(160)
  message   String   @db.VarChar(500)
  href      String?  @db.VarChar(255)
  readAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

/// Phase 2I: internal STAR PYRAMIDS support conversations (customer ↔
/// staff). One conversation thread per customer support need; the
/// customer UX centers on their latest thread while staff work from a
/// cross-customer inbox. `customerId` is the owning customer (server
/// session, never browser input). `assignedStaffId` is the staff owner
/// (nullable, staff-set only). `subject` is an optional short context
/// label (e.g. a booking reference the question relates to). `status`
/// is OPEN or CLOSED; closed threads are read-only history — new
/// customer messages open a fresh thread. `lastMessageAt` orders the
/// staff inbox. External/WhatsApp channels are NOT modeled here.
enum SupportConversationStatus {
  OPEN
  CLOSED
}

model SupportConversation {
  id              String                    @id @default(cuid())
  reference       String                    @unique @db.VarChar(16)
  customerId      String
  subject         String?                   @db.VarChar(160)
  status          SupportConversationStatus @default(OPEN)
  assignedStaffId String?
  lastMessageAt   DateTime                  @default(now())
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  closedAt        DateTime?

  customer User  @relation("SupportCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  assignee User? @relation("SupportAssignee", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  messages SupportMessage[]

  @@index([customerId, updatedAt])
  @@index([status, lastMessageAt])
  @@map("support_conversations")
}

/// Phase 2I: plain-text support messages. `senderRole` is stamped
/// server-side from the authenticated session ('customer' | 'staff') —
/// the browser never declares who sends. `body` is validated plain
/// text (1–2000 chars, no control characters); rendering must treat it
/// as text, never HTML. `readAt` is the recipient-side read marker:
/// NULL means unread by the other side. No attachments, reactions, or
/// external-channel payloads in this phase.
model SupportMessage {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  senderRole     String   @db.VarChar(16)
  body           String   @db.VarChar(2000)
  readAt         DateTime?
  createdAt      DateTime @default(now())

  conversation SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User                @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("support_messages")
}
